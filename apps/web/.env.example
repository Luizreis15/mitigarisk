# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store
SUPABASE_DB_URL=replace-in-secret-store

# Server-only email configuration
RESEND_API_KEY=replace-in-secret-store
RESEND_FROM_EMAIL=MITIGA <no-reply@example.com>
RESEND_WEBHOOK_SECRET=replace-in-secret-store

# Application
APP_URL=http://localhost:3000
APP_ENV=development
