#!/bin/sh
set -eu

blocked_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v -E '\.env\.example$' || true)"

if [ -n "$blocked_files" ]; then
  echo "Commit blocked: environment files must not be versioned."
  echo "$blocked_files"
  exit 1
fi

secret_hits="$(git diff --cached --no-ext-diff --unified=0 | grep '^+' | grep -E '(re_[A-Za-z0-9]{20,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|postgres(ql)?://[^[:space:]]+:[^[:space:]]+@)' || true)"

if [ -n "$secret_hits" ]; then
  echo "Commit blocked: a value resembling a credential was found."
  echo "Rotate exposed credentials and replace them with environment variables."
  exit 1
fi
